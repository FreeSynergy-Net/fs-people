fix-fields = Einige Felder sind nicht gültig. Korrigiere sie zuerst.
email-placeholder = name@example.org
phone-placeholder = +49 30 1234567
not-deleted = Nicht gelöscht: {$v}
cannot-edit = Das lässt sich nicht bearbeiten: {$v}
unreadable = Das ließ sich nicht lesen: {$v}
list-failed = Die Liste ist fehlgeschlagen: {$v}
conflict-confirm = {$v} Dein Text bleibt erhalten. Drücke noch einmal Speichern, um trotzdem zu schreiben.
f-ai = KI
f-sensitive = Sensibel: {$v}
