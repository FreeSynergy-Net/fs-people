f-other = So übernommen, wie es kam
f-unreadable = ließ sich nicht lesen: {$v}
f-unsupported = von dieser Quelle nicht angeboten (Code unsupported, Fähigkeit {$capability}, Quelle {$provider})
no-checked-update = Bearbeiten ist gesperrt: Diese Quelle kann nicht in einem Schritt prüfen und schreiben, eine Änderung von jemand anderem ginge sonst verloren (people/no-checked-update).
p-empty = Nichts eingegeben.
p-missing-at = Eine E-Mail-Adresse braucht ein @, etwa name@example.org.
p-many-at = Eine E-Mail-Adresse hat nur ein @.
p-empty-local = Gib den Teil vor dem @ ein.
p-empty-domain = Gib den Teil nach dem @ ein, etwa example.org.
p-local-character = Der Teil vor dem @ enthält ein unerlaubtes Zeichen (ein Leerzeichen oder einen Punkt am Anfang, am Ende oder doppelt).
p-local-too-long = Der Teil vor dem @ ist länger als 64 Zeichen.
p-bad-domain = Der Teil nach dem @ ist kein gültiger Domainname.
p-domain-without-dot = Die Domain braucht einen Punkt, etwa example.org.
p-no-country-code = Beginne mit + und der Landesvorwahl (nicht 0), etwa +49 30 1234567.
p-phone-character = Eine Telefonnummer besteht aus Ziffern, dazwischen Leerzeichen, Punkte, Bindestriche oder Klammern.
p-address-too-long = Die ganze Adresse ist länger als 254 Zeichen.
p-phone-length = Eine Telefonnummer hat nach dem + 7 bis 15 Ziffern, die erste nicht 0.
menu-contacts = Kontakte
menu-import = Importieren …
menu-export = Exportieren …
menu-later = Braucht den Datei-Wähler; kommt in einem späteren Lauf dieser Version.
import-done = {$created} importiert, {$skipped} schon bekannt
import-failed = {$n} fehlgeschlagen: {$list}
import-unclear = Sensibel ohne Kategorie, als sensibel behalten: {$list}
import-stopped = Der Import wurde angehalten: {$why}
export-wrote = {$n} nach {$path} geschrieben
export-released = Von dir freigegeben: {$list}
export-left-out = Als sensibel ausgelassen (eine mit --export-sensitive <uid> nennen): {$list}
