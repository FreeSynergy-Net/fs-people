# The words of the window of FreeSynergy People, English (ADR 0057: MessageFormat 2). Every id needs a German twin in de.mf2.
app-name = FreeSynergy People
nav-all = All contacts
nav-groups = Groups
groups-title = Groups live in FreeSynergy Groups
groups-text = People does not keep groups or their members; FreeSynergy Groups does. Opening a group from a person comes with a later version.
search = Search people
col-name = Name
col-email = E-mail
more = Show more
create = New
edit = Edit
save = Save
cancel = Cancel
delete = Delete
delete-really = Really delete
delete-keep = Keep
add-field = Add: {$v}
nothing-selected = Choose a person on the left to see the details.
nobody = No contacts yet. Create the first one with "New", or import a vCard file.
nobody-found = Nobody found for "{$v}".
delete-confirm = Delete {$v}? This cannot be taken back here.
gone = This person no longer exists.
unsaved = Save or cancel your changes first.
discard-confirm = You have unsaved changes. Keep editing, or discard them.
discard-keep = Keep editing
discard-really = Discard changes
saved = Saved.
created = Created.
deleted = {$v} was deleted.
no-changes = Nothing was changed.
not-saved = Not saved: {$v}
fix-fields = Some fields are not valid. Correct them first.
email-placeholder = name@example.org
phone-placeholder = +49 30 1234567
not-deleted = Not deleted: {$v}
cannot-edit = Cannot edit this: {$v}
unreadable = This could not be read: {$v}
list-failed = The list failed: {$v}
conflict-confirm = {$v} Your text is kept. Press Save again to write it anyway.
f-ai = AI
f-sensitive = Sensitive: {$v}
f-sensitive-row = Sensitive
f-unclear = categories unclear
f-contact = Contact
f-work = Organisation
f-places = Addresses
f-about = About
f-roles = Roles
f-kept = More on the card
f-name = Name
f-email = E-mail
f-phone = Phone
f-organisation = Organisation
f-job = Title
f-address = Address
f-nickname = Nickname
f-link = Link
f-note = Note
f-kind = Kind
f-role = Role
f-other = Kept as it came
f-unreadable = could not be read: {$v}
f-unsupported = not offered by this source (code unsupported, capability {$capability}, source {$provider})
no-checked-update = Editing is locked: this source cannot compare and write in one step, so a change by someone else could be lost (people/no-checked-update).
p-empty = Nothing typed.
p-missing-at = An e-mail address needs an @, like name@example.org.
p-many-at = An e-mail address has only one @.
p-empty-local = Type the part before the @.
p-empty-domain = Type the part after the @, like example.org.
p-local-character = The part before the @ holds a character that is not allowed (a space, or a dot at the start, at the end or twice).
p-local-too-long = The part before the @ is longer than 64 characters.
p-bad-domain = The part after the @ is not a valid domain name.
p-domain-without-dot = The domain needs a dot, like example.org.
p-no-country-code = Start with + and the country code (not 0), like +49 30 1234567.
p-phone-character = A phone number holds digits, and spaces, dots, hyphens or brackets between them.
p-address-too-long = The whole address is longer than 254 characters.
p-phone-length = A phone number has 7 to 15 digits after the +, the first not 0.
menu-contacts = Contacts
menu-import = Import…
menu-export = Export…
menu-later = Needs the file chooser; comes in a later run of this version.
import-done = Imported {$created}, {$skipped} already known
import-failed = {$n} failed: {$list}
import-unclear = Sensitive without a category, kept as sensitive: {$list}
import-stopped = The import stopped: {$why}
export-wrote = Wrote {$n} to {$path}
export-released = Released by you: {$list}
export-left-out = Left out as sensitive (name one with --export-sensitive <uid>): {$list}
export-failed = Failed: {$list}
menu-groups = Groups
